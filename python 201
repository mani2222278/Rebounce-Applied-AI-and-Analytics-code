        "FILE_NAME = \"expenses.json\"\n",
        "\n",
        "# Load expenses\n",
        "if os.path.exists(FILE_NAME):\n",
        "    with open(FILE_NAME, \"r\") as file:\n",
        "        expenses = json.load(file)\n",
        "else:\n",
        "    expenses = []\n",
        "\n",
        "\n",
        "def add_expense():\n",
        "    category = input(\"Enter category: \")\n",
        "    amount = float(input(\"Enter amount: \"))\n",
        "    description = input(\"Enter description: \")\n",
        "\n",
        "    expense = {\n",
        "        \"category\": category,\n",
        "        \"amount\": amount,\n",
        "        \"description\": description\n",
        "    }\n",
        "\n",
        "    expenses.append(expense)\n",
        "    print(\"Expense added successfully!\\n\")\n",
        "\n",
        "\n",
        "def view_expenses():\n",
        "    if not expenses:\n",
        "        print(\"No expenses found.\\n\")\n",
        "        return\n",
        "\n",
        "    print(\"\\n===== All Expenses =====\")\n",
        "    for i, e in enumerate(expenses,start=1):\n",
        "        print(f\"{i}. Category    : {e['category']}\")\n",
        "        print(f\"   Amount      : Rs {e['amount']:.2f}\")\n",
        "        print(f\"   Description : {e['description']}\")\n",
        "        print()\n",
        "\n",
        "\n",
        "def total_spent():\n",
        "    total = sum(e[\"amount\"] for e in expenses)\n",
        "    print(f\"\\nTotal Amount Spent: Rs {total:.2f}\\n\")\n",
        "\n",
        "\n",
        "def category_totals():\n",
        "    totals = {}\n",
        "\n",
        "    for e in expenses:\n",
        "        category = e[\"category\"]\n",
        "        totals[category] = totals.get(category, 0) + e[\"amount\"]\n",
        "\n",
        "    print(\"\\n===== Totals by Category =====\")\n",
        "    for category, amount in totals.items():\n",
        "        print(f\"{category}: Rs {amount:.2f}\")\n",
        "\n",
        "    total = sum(totals.values())\n",
        "    print(f\"Total: Rs {total:.2f}\\n\")\n",
        "\n",
        "\n",
        "def save_data():\n",
        "    with open(FILE_NAME, \"w\") as file:\n",
        "        json.dump(expenses, file, indent=4)\n",
        "    print(\"Data saved successfully!\")\n",
        "\n",
        "def main():\n",
        "    while True:\n",
        "        print(\"\\n===== Expense Tracker =====\")\n",
        "        print(\"1. Add Expense\")\n",
        "        print(\"2. View All Expenses\")\n",
        "        print(\"3. View Total Amount\")\n",
        "        print(\"4. View Totals by Category\")\n",
        "        print(\"5. Save and Exit\")\n",
        "\n",
        "        choice = input(\"Enter your choice: \")\n",
        "\n",
        "        if choice == \"1\":\n",
        "            add_expense()\n",
        "\n",
        "        elif choice == \"2\":\n",
        "            view_expenses()\n",
        "\n",
        "        elif choice == \"3\":\n",
        "            total_spent()\n",
        "\n",
        "        elif choice == \"4\":\n",
        "            category_totals()\n",
        "\n",
        "        elif choice == \"5\":\n",
        "            save_data()\n",
        "            print(\"Thank you for using Expense Tracker!\")\n",
        "            break\n",
        "\n",
        "        else:\n",
        "            print(\"Invalid choice! Please try again.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
