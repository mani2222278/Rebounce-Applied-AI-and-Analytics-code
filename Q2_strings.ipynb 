        "colab": {
          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Released in 1982\n",
            "Released in 1982\n",
            "Released in 1982\n"
          ]
        }
      ],
      "source": [
        "year = 1982\n",
        "\n",
        "# This is broken - you cannot add a number to a string.\n",
        "# print(\"Released in \" + year)\n",
        "\n",
        "# Fix 1: cast the number to a string.\n",
        "print(\"Released in \" + str(year))\n",
        "\n",
        "# Fix 2: give print() several things and let it handle the joining.\n",
        "print(\"Released in\", year)\n",
        "\n",
        "# Fix 3 (the modern way): an f-string. Put the variable in curly braces.\n",
        "print(f\"Released in {year}\")"
      ],
      "id": "mjCpKC-MbSEW"
